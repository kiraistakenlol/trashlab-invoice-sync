# Intuit developer app (developer.intuit.com → your app → Development keys)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must be listed exactly in the app's Redirect URIs
QBO_REDIRECT_URI=http://localhost:3000/callback
QBO_ENVIRONMENT=sandbox
# app → Development → Webhooks → Show verifier token (signs webhook deliveries)
QBO_WEBHOOK_VERIFIER_TOKEN=
