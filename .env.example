# Sync service database (docker-compose.yml runs this Postgres)
DATABASE_URL=postgres://sync:sync@localhost:5432/invoice_sync
# HTTP port for webhooks and the read API (default 3000)
PORT=3000
# pino level: trace, debug, info, warn, error (default info)
LOG_LEVEL=info

# Invoicing system API
INVOICING_API_URL=http://localhost:4000
INVOICING_API_TOKEN=

# Intuit developer app (developer.intuit.com → your app → Development keys)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must be listed exactly in the app's Redirect URIs. `pnpm qbo:auth` listens on its port, so on
# the defaults (PORT=3000) it can't run while the service does.
QBO_REDIRECT_URI=http://localhost:3000/callback
QBO_ENVIRONMENT=sandbox
# app → Development → Webhooks → Show verifier token (signs webhook deliveries)
QBO_WEBHOOK_VERIFIER_TOKEN=
# Connection state (realm id + tokens) written by `pnpm qbo:auth` and on every refresh
QBO_CONNECTION_FILE=qbo-playground/.qbo-connection.json

# Worker and polling (defaults shown)
WORKER_CONCURRENCY=2
WORKER_IDLE_MS=1000
POLL_INTERVAL_MS=60000
