{
  "name": "trashlab-invoice-sync",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "^22.15.0 || >=23.8.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "vitest run --project offline",
    "test:sandbox": "vitest run --project sandbox",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "mkdir -p logs && tsx watch --env-file-if-exists=.env src/main.ts | tee -a logs/sync.log | pino-pretty",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "invoicing:dev": "tsx --env-file-if-exists=.env invoicing-sim/main.ts",
    "demo": "tsx --env-file-if-exists=.env demo/run.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/cli/db-reset.ts",
    "sync:reconcile": "tsx --env-file-if-exists=.env src/cli/reconcile.ts",
    "qbo:auth": "tsx qbo-playground/src/auth.ts",
    "qbo:call": "tsx qbo-playground/src/call.ts",
    "qbo:webhooks": "tsx qbo-playground/src/webhook-server.ts",
    "qbo:explore": "sh -c 'tsx qbo-playground/src/explore/$0.ts \"$@\"'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/big.js": "^7.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "fastify": "^5.12.7",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  }
}
